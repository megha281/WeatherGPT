# ---------------------------------------------------------------
# WeatherGPT backend environment variables
# Copy this file to ".env" and fill in the values.
# NEVER commit your real .env file.
# ---------------------------------------------------------------

PORT=5000
NODE_ENV=development

# MongoDB: local ("mongodb://127.0.0.1:27017/weathergpt")
# or MongoDB Atlas ("mongodb+srv://user:pass@cluster.mongodb.net/weathergpt")
MONGODB_URI=mongodb://127.0.0.1:27017/weathergpt

# Any long random string. Example generator:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google Gemini API key -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Frontend origin (used for CORS and for links inside emails)
FRONTEND_URL=http://localhost:5173

# Email (optional). If left blank, reset/verification links are printed
# to the backend terminal instead (development fallback).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=WeatherGPT <no-reply@weathergpt.local>

# Set to "true" to also return reset/verification tokens in the API
# response while developing. Keep "false" in production.
EXPOSE_DEV_TOKENS=true
